# 400 Club mint dapp — environment template
# Copy to .env and fill in. Production deploys read .env.production.

# ---------------------------------------------------------------------------
# CHAIN — defaults to MegaETH mainnet (chain 4326).
# Override to MegaETH testnet (6342) for the dry run.
# ---------------------------------------------------------------------------
VITE_CHAIN_ID=4326
VITE_RPC_URL=https://mainnet.megaeth.com/rpc

# Optional: override the per-chain RPC fallbacks defined in Web3Provider.tsx.
# These are read by the chain definitions; useful if you bring your own paid
# Alchemy / dRPC endpoint (recommended on launch day).
VITE_MEGAETH_CHAIN_ID=4326
VITE_MEGAETH_RPC=https://mainnet.megaeth.com/rpc
VITE_MEGAETH_EXPLORER=https://mega.etherscan.io

VITE_MEGAETH_TESTNET_CHAIN_ID=6342
VITE_MEGAETH_TESTNET_RPC=https://carrot.megaeth.com/rpc
VITE_MEGAETH_TESTNET_EXPLORER=https://megaeth-testnet-v2.blockscout.com

# ---------------------------------------------------------------------------
# WALLET — get a project id from https://cloud.walletconnect.com
# ---------------------------------------------------------------------------
VITE_WALLETCONNECT_PROJECT_ID=YOUR_WC_PROJECT_ID

# ---------------------------------------------------------------------------
# CONTRACT — fill after `npm run deploy:megaeth` writes deployments/megaeth_latest.json
# ---------------------------------------------------------------------------
VITE_CONTRACT_ADDRESS=0xYourContract

# ---------------------------------------------------------------------------
# Image base — ipfs://CID/ once revealed, /images/collection during build.
# ---------------------------------------------------------------------------
VITE_IMAGE_BASE=/images/collection

# ---------------------------------------------------------------------------
# Same vars under NEXT_PUBLIC_ aliases (the lib/env helper accepts both).
# Leave blank unless you're embedding in a Next.js wrapper.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_IMAGE_BASE=
